def membresia_triangular(x, a, b, c):
    # Implementación computacional de las funciones a trozos
    if x <= a or x >= c:
        return 0.0
    elif a < x <= b:
        return (x - a) / (b - a)
    elif b < x < c:
        return (c - x) / (c - b)

conjuntos = {
    "Novato": (0, 0, 5),
    "Intermedio": (2, 5, 8),
    "Experto": (5, 10, 20)
}

conductores = [3,6,12]

for años in conductores :
    grados = {
        nombre: membresia_triangular(años,a,b,c)
         for nombre, (a, b, c) in conjuntos.items()
    }

    print(f"Conductor con {años} años de experiencia:")
    for nombre, grado in grados.items():
        print(f" - pertenece a  {nombre} en un  {grado * 100:.1f}%")

        categoria = max(grados, key=grados.get)
        print(f" => Categoría dominante: {categoria} (grados{grados[categoria]: . 2f}")